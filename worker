/**
 * Lugoba Miracle Center Church - Relworx mobile money donations
 * Cloudflare Worker (free plan, no card needed).
 *
 * Needs (set in the Cloudflare dashboard, never in this file):
 *   Secret:     RELWORX_API_KEY
 *   Secret:     RELWORX_ACCOUNT_NO
 *   KV binding: DONATIONS   (a KV namespace)
 */

const RELWORX_BASE = 'https://payments.relworx.com/api/mobile-money';
const MIN_AMOUNT = 1000;
const MAX_AMOUNT = 5000000;
const PURPOSES = ['Tithe', 'Offering', 'Building Fund', 'Missions & Outreach', 'Support the Needy', 'Other'];
const ALLOWED_ORIGINS = [
  'https://www.lugobamiraclecenterchurch.com',
  'https://lugobamiraclecenterchurch.com',
  'http://localhost:5000',
  'http://localhost:8080',
  'http://127.0.0.1:5500'
];

function corsHeaders(req) {
  const origin = req.headers.get('Origin');
  const h = {
    'Access-Control-Allow-Methods': 'POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
    'Access-Control-Max-Age': '3600',
    'Vary': 'Origin'
  };
  if (origin && ALLOWED_ORIGINS.includes(origin)) h['Access-Control-Allow-Origin'] = origin;
  return h;
}

function reply(req, obj, status) {
  return new Response(JSON.stringify(obj), {
    status: status || 200,
    headers: Object.assign({ 'Content-Type': 'application/json' }, corsHeaders(req))
  });
}

// 07xxxxxxxx / 2567xxxxxxxx / +2567xxxxxxxx -> +2567xxxxxxxx (or '' if invalid)
function normPhone(v) {
  const d = String(v || '').replace(/[^\d]/g, '');
  if (/^07\d{8}$/.test(d)) return '+256' + d.slice(1);
  if (/^2567\d{8}$/.test(d)) return '+' + d;
  if (/^7\d{8}$/.test(d)) return '+256' + d;
  return '';
}

function newReceiptNo() {
  const b = crypto.getRandomValues(new Uint8Array(5));
  return 'LMCC-' + Array.from(b).map(x => x.toString(16).padStart(2, '0')).join('').toUpperCase();
}

function publicView(d) {
  return {
    receiptNo: d.receiptNo, name: d.name, purpose: d.purpose, amount: d.amount,
    currency: d.currency, method: d.method, status: d.status, reference: d.reference || ''
  };
}

async function relworx(env, path, init) {
  const r = await fetch(RELWORX_BASE + path, Object.assign({
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/vnd.relworx.v2',
      'Authorization': 'Bearer ' + env.RELWORX_API_KEY
    }
  }, init));
  let body = {};
  try { body = await r.json(); } catch (e) { /* non-JSON */ }
  return { ok: r.ok, status: r.status, body };
}

const save = (env, d) => env.DONATIONS.put('donation:' + d.receiptNo, JSON.stringify(d));

async function requestPayment(req, env) {
  let b = {};
  try { b = await req.json(); } catch (e) { /* bad body */ }

  const name = String(b.name || '').trim();
  const email = String(b.email || '').trim().slice(0, 160);
  const purpose = String(b.purpose || '');
  const amount = Math.round(Number(b.amount));
  const phone = normPhone(b.phone);
  const payFrom = normPhone(b.payFrom || b.phone);
  const method = b.method === 'airtel' ? 'airtel' : 'mtn';

  if (!name || name.length > 120) return reply(req, { error: 'Please enter your full name.' }, 400);
  if (!phone) return reply(req, { error: 'Please enter a valid Ugandan phone number.' }, 400);
  if (!payFrom) return reply(req, { error: 'Please enter a valid mobile money number.' }, 400);
  if (!PURPOSES.includes(purpose)) return reply(req, { error: 'Invalid giving purpose.' }, 400);
  if (!amount || amount < MIN_AMOUNT || amount > MAX_AMOUNT) {
    return reply(req, { error: 'Amount must be between UGX ' + MIN_AMOUNT.toLocaleString('en-UG') + ' and UGX ' + MAX_AMOUNT.toLocaleString('en-UG') + '.' }, 400);
  }

  const receiptNo = newReceiptNo();
  const rec = {
    receiptNo, name, phone, email, purpose, amount, currency: 'UGX', method,
    payFrom, reference: '', status: 'pending', gateway: 'relworx',
    at: new Date().toISOString()
  };
  await save(env, rec);

  try {
    const r = await relworx(env, '/request-payment', {
      method: 'POST',
      body: JSON.stringify({
        account_no: env.RELWORX_ACCOUNT_NO,
        reference: receiptNo,
        msisdn: payFrom,
        currency: 'UGX',
        amount: amount,
        description: ('Donation - ' + purpose).slice(0, 100)
      })
    });
    if (!r.ok || !r.body.success || !r.body.internal_reference) {
      rec.status = 'failed';
      rec.failReason = String(r.body.message || r.status).slice(0, 200);
      await save(env, rec);
      const msg = r.status === 429
        ? 'Too many attempts for this number. Please wait 10 minutes and try again.'
        : (r.body.message || 'The payment request could not be sent. Please try again.');
      return reply(req, { error: msg }, 502);
    }
    rec.internalReference = r.body.internal_reference;
    await save(env, rec);
    return reply(req, { receiptNo, message: 'Check your phone and enter your Mobile Money PIN to approve.' });
  } catch (err) {
    rec.status = 'failed';
    rec.failReason = 'network error';
    await save(env, rec);
    return reply(req, { error: 'Could not reach the payment service. Please try again.' }, 502);
  }
}

async function checkStatus(req, env) {
  let b = {};
  try { b = await req.json(); } catch (e) { /* bad body */ }
  const receiptNo = String(b.receiptNo || '');
  if (!/^LMCC-[0-9A-F]{10}$/.test(receiptNo)) return reply(req, { error: 'Invalid receipt number.' }, 400);

  const raw = await env.DONATIONS.get('donation:' + receiptNo);
  if (!raw) return reply(req, { error: 'Donation not found.' }, 404);
  const d = JSON.parse(raw);

  if (d.status !== 'pending' || !d.internalReference) return reply(req, publicView(d));

  try {
    const qs = '/check-request-status?internal_reference=' + encodeURIComponent(d.internalReference) +
               '&account_no=' + encodeURIComponent(env.RELWORX_ACCOUNT_NO);
    const r = await relworx(env, qs, { method: 'GET' });
    const s = String(r.body.request_status || r.body.status || '').toLowerCase();

    if (r.ok && s === 'success') {
      // never trust a "paid" status unless the amount matches what we asked for
      if (Number(r.body.amount) === Number(d.amount)) {
        d.status = 'paid';
        d.reference = String(r.body.provider_transaction_id || '');
        d.provider = String(r.body.provider || '');
        d.paidAt = new Date().toISOString();
      } else {
        d.status = 'review';
        d.failReason = 'amount mismatch';
      }
      await save(env, d);
    } else if (r.ok && s === 'failed') {
      d.status = 'failed';
      d.failReason = String(r.body.message || '').slice(0, 200);
      await save(env, d);
    }
  } catch (err) {
    // leave as pending; the page will retry
  }
  return reply(req, publicView(d));
}

export default {
  async fetch(req, env) {
    if (req.method === 'OPTIONS') return new Response(null, { status: 204, headers: corsHeaders(req) });
    if (req.method !== 'POST') return reply(req, { error: 'Method not allowed' }, 405);

    const path = new URL(req.url).pathname.replace(/\/+$/, '');
    if (path === '/relworxRequestPayment') return requestPayment(req, env);
    if (path === '/relworxCheckStatus') return checkStatus(req, env);
    return reply(req, { error: 'Not found' }, 404);
  }
};
